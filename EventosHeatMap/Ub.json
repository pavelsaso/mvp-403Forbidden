{
  "goToNearestBike": {
    "action": "detect_user_location",
    "steps": [
      {
        "type": "get_geolocation",
        "save_as": "userLocation"
      },
      {
        "type": "remove_marker_if_exists",
        "target": "userMarker"
      },
      {
        "type": "create_marker",
        "target": "userMarker",
        "position_from": "userLocation",
        "icon": "userIcon"
      },
      {
        "type": "update_text",
        "element": "iaStatus",
        "value": "Ubicación detectada. IA lista."
      }
    ]
  },

  "activateDestinationSelection": {
    "action": "wait_map_click",
    "steps": [
      {
        "type": "validate_exists",
        "target": "userLocation",
        "if_false": "Primero detecta ubicación"
      },
      {
        "type": "capture_click_destination",
        "save_as": "dest"
      },
      {
        "type": "remove_marker_if_exists",
        "target": "destMarker"
      },
      {
        "type": "create_marker",
        "target": "destMarker",
        "position_from": "dest",
        "icon": "destIcon"
      },
      {
        "type": "find_nearest_graph_node",
        "from": "userLocation",
        "save_as": "startNode"
      },
      {
        "type": "find_nearest_graph_node",
        "from": "dest",
        "save_as": "endNode"
      },
      {
        "type": "run_dijkstra",
        "start": "startNode",
        "end": "endNode",
        "save_as": "bestPath"
      },
      {
        "type": "draw_graph_route",
        "path": "bestPath",
        "origin": "userLocation",
        "destination": "dest"
      }
    ]
  }
}